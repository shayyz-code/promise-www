---
import { Font } from 'astro:assets'
import SeoHead from '../components/layout/seo-head.astro'
import type { Locale, Section } from '../i18n/config'
import { getBusiness } from '../lib/content'
import { serializeJsonLd, storeJsonLd, websiteJsonLd } from '../lib/structured-data'
import headScript from '../scripts/head.inline.js?raw'
import '../styles/tokens.css'
import '../styles/global.css'

interface Props {
  /** Omit for pages outside both sections (the 404): no canonical, alternates or JSON-LD. */
  section?: Section
  locale: Locale
  title: string
  description: string
  /** Class for <body>, for page-level backgrounds. */
  class?: string
}

const { section, locale, title, description, class: bodyClass } = Astro.props
const business = await getBusiness()
const siteUrl = new URL('/', Astro.site).href
const jsonLd = [
  ...(section ? [storeJsonLd(business, siteUrl)] : []),
  ...(section === 'home' ? [websiteJsonLd(business, siteUrl)] : []),
].map(serializeJsonLd)
// Order matters: the inline head script reads the hreflang alternates rendered by <SeoHead> above it.
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    {
      section ? (
        <SeoHead section={section} locale={locale} title={title} description={description} />
      ) : (
        <>
          <title>{title}</title>
          <meta name="description" content={description} />
          <meta name="robots" content="noindex" />
        </>
      )
    }
    <script is:inline set:html={headScript} />
    <Font cssVariable="--font-bricolage" preload={locale === 'en' ? [{ subset: 'latin' }] : false} />
    <Font
      cssVariable="--font-baloo"
      preload={section === 'desk' && locale === 'en' ? [{ subset: 'latin' }] : false}
    />
    <Font cssVariable="--font-myanmar" preload={locale === 'my' ? [{ weight: '700' }] : false} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1e3152" />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={block} />)}
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import '../scripts/language-preference'
    </script>
  </body>
</html>
