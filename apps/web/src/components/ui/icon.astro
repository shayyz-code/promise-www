---
import { type IconName, icons } from './icons'

interface Props {
  name: IconName
  /** Rendered width and height in px. */
  size?: number
  strokeWidth?: number
  class?: string
}

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
