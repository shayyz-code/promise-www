---
import { getDictionary } from '../../i18n'
import { type Locale, localeLabels, type Section } from '../../i18n/config'
import { localizedPath } from '../../i18n/routes'

interface Props {
  section: Section
  locale: Locale
  /** home: outlined pill · desk: boxed "sticker" control */
  variant: 'home' | 'desk'
}

const { section, locale, variant } = Astro.props
const t = getDictionary(locale, 'common')
const options = (['en', 'my'] as const).map((option) => ({
  locale: option,
  label: localeLabels[option],
  href: localizedPath(section, option),
  current: option === locale,
}))
---

<div
  class:list={['lang-switch', `lang-switch--${variant}`]}
  role="group"
  aria-label={t.langGroup}
  data-testid="lang-switch"
>
  {
    options.map((option) => (
      <a
        href={option.href}
        hreflang={option.locale}
        lang={option.locale}
        data-lang-choice={option.locale}
        aria-current={option.current ? 'true' : undefined}
      >
        {option.label}
      </a>
    ))
  }
</div>

<style>
  .lang-switch {
    display: inline-flex;
    flex-shrink: 0;
  }

  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: var(--color-navy);
    font-size: 14px;
    font-weight: 700;
  }

  .lang-switch a[aria-current] {
    background: var(--color-navy);
    color: var(--color-cream);
    cursor: default;
  }

  /* English pages show the Myanmar label in the system font rather than downloading the webfont. */
  :global(html[lang='en']) .lang-switch a[lang='my'] {
    font-family: system-ui, sans-serif;
  }

  /* Home: outlined pill */
  .lang-switch--home a {
    min-height: 44px;
    min-width: 52px;
    padding: 0 14px;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-navy);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .lang-switch--home a:first-child {
    border-radius: 999px 0 0 999px;
  }

  .lang-switch--home a:last-child {
    border-radius: 0 999px 999px 0;
    margin-left: -1.5px;
  }

  .lang-switch--home a:not([aria-current]):hover {
    background: rgb(30 49 82 / 0.08);
  }

  /* Promise Desk: boxed control with an offset shadow */
  .lang-switch--desk {
    border: 2px solid var(--color-navy);
    border-radius: 12px;
    background: var(--color-card);
    box-shadow: 3px 3px 0 var(--color-navy);
  }

  .lang-switch--desk a {
    min-height: 40px;
    min-width: 46px;
    padding: 0 13px;
    line-height: 1.2;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .lang-switch--desk a:first-child {
    border-radius: 10px 0 0 10px;
  }

  .lang-switch--desk a:last-child {
    border-radius: 0 10px 10px 0;
  }

  .lang-switch--desk a:not([aria-current]):hover {
    background: var(--color-cream);
  }

  .lang-switch--desk a[lang='my'] {
    line-height: 1.5;
  }

  .lang-switch--desk a:focus-visible {
    outline-offset: 4px;
  }

  @media (max-width: 419px) {
    .lang-switch--home a {
      min-width: 44px;
      padding: 0 10px;
    }
  }

  @media (max-width: 400px) {
    .lang-switch--desk a {
      padding: 0 10px;
    }
  }
</style>
