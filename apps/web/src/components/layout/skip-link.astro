---
interface Props {
  label: string
  variant: 'home' | 'desk'
}

const { label, variant } = Astro.props
---

<a class:list={['skip-link', `skip-link--${variant}`]} href="#main">{label}</a>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -80px;
    z-index: 100;
    font-weight: 700;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 12px;
  }

  .skip-link--home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 6px;
    background: var(--color-navy);
    color: var(--color-cream);
  }

  .skip-link--desk {
    padding: 12px 18px;
    border: 2px solid var(--color-navy);
    border-radius: 12px;
    background: var(--color-desk-yellow);
    color: var(--color-navy);
    box-shadow: 4px 4px 0 var(--color-navy);
  }
</style>
