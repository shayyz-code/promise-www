---
/*
 * A word underlined (or circled) by hand in gold. The word is the slot. Write the component inline with the
 * surrounding sentence fragments, with no whitespace between them: the fragments carry their own spaces.
 */
type Shape = 'hero' | 'promise-1' | 'promise-2' | 'promise-3' | 'circle'

interface Props {
  shape: Shape
}

const paths = {
  hero: 'M1 8C22 3 48 10 70 6S92 3 99 5',
  'promise-1': 'M1 7C24 3 52 10 99 5',
  'promise-2': 'M1 6C30 10 60 3 99 7',
  'promise-3': 'M1 8C20 4 46 9 70 5S94 4 99 6',
  circle: 'M70 6C38 2 6 12 5 31c-1 19 32 26 60 24 28-2 51-12 50-28C114 10 88 3 58 6',
} as const satisfies Record<Shape, string>

const { shape } = Astro.props
const variant = shape === 'hero' || shape === 'circle' ? shape : 'promise'
// The hero underline draws on load; the others draw as they scroll into view.
const timing = shape === 'hero' ? 'home-draw--load' : 'home-draw-view'
const viewBox = shape === 'circle' ? '0 0 120 60' : '0 0 100 12'
---

<span class:list={['mark', `mark--${variant}`]}><slot /><svg viewBox={viewBox} preserveAspectRatio="none" aria-hidden="true"><path class:list={['home-draw', timing]} pathLength="1" d={paths[shape]}></path></svg></span>

<style>
  .mark {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  svg {
    position: absolute;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 3.4;
    stroke-linecap: round;
  }

  .mark--hero svg {
    left: 0;
    bottom: -0.1em;
    width: 96%;
    height: 0.24em;
  }

  .mark--hero path {
    stroke-width: 3.2;
    animation-delay: 1.15s;
    animation-duration: 0.9s;
  }

  .mark--promise svg {
    left: -2%;
    bottom: -0.12em;
    width: 104%;
    height: 0.26em;
  }

  .mark--circle svg {
    left: -16%;
    top: -14%;
    width: 132%;
    height: 128%;
  }
</style>
