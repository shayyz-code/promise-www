---
import LanguageSwitch from '../../../components/layout/language-switch.astro'
import LogoMark from '../../../components/ui/logo-mark.astro'
import { getDictionary } from '../../../i18n'
import type { Locale } from '../../../i18n/config'
import { discordHref, telegramHref, viberHref } from '../../../lib/contact'
import { getBusiness } from '../../../lib/content'
import { platformNames, wordmark } from '../brand'
import { deskLinkAttrs } from '../links'
import TopBar from './top-bar.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale, 'home')
const business = await getBusiness()
const [primary] = business.phones
---

<header>
  <TopBar locale={locale} />
  <div class="head">
    <a class="logo" href="#top" aria-label={t.homeLabel}>
      <LogoMark />
      <span class="wordmark" lang="en">
        <span class="wordmark__name">{wordmark.name}</span>
        <span class="wordmark__tag">{wordmark.tagline}</span>
      </span>
    </a>
    <nav class="nav" aria-label={t.navMain}>
      <a class="tap" href="#orders"><span class="home-u">{t.navOffices}</span></a>
      <a class="tap" {...deskLinkAttrs}><span class="home-u">{t.navDesk}</span></a>
      <a class="tap" href="#range"><span class="home-u">{t.navRange}</span></a>
      <a class="tap" href="#visit"><span class="home-u">{t.navVisit}</span></a>
    </nav>
    <div class="actions">
      <LanguageSwitch section="home" locale={locale} variant="home" />
      <a class="pill home-pill" href={telegramHref(business.telegram.shop)} lang="en">
        {platformNames.telegram}
      </a>
      <a class="pill home-pill" href={discordHref(business.discordInvite)} lang="en">
        {platformNames.discord}
      </a>
      {
        primary && (
          <a class="viber home-btn" href={viberHref(primary.number)} lang="en">
            {platformNames.viber}
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  .head {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }

  .logo :global(.logo-mark) {
    width: 32px;
    height: 44px;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .wordmark__name {
    font-size: 28px;
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.04em;
  }

  .wordmark__tag {
    padding-left: 1px;
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    font-size: 15px;
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .pill,
  .viber {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
  }

  .pill {
    padding: 0 16px;
  }

  .viber {
    padding: 0 20px;
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .nav {
      order: 3;
      flex-basis: 100%;
    }
  }

  @media (max-width: 767px) {
    .head {
      gap: 10px;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .logo :global(.logo-mark) {
      width: 26px;
      height: 36px;
    }

    .wordmark__name {
      font-size: 24px;
    }

    .wordmark__tag {
      font-size: 7.5px;
      letter-spacing: 0.16em;
    }

    .actions {
      gap: 8px;
    }

    .viber {
      padding: 0 14px;
      font-size: 15px;
    }

    .nav,
    .pill {
      display: none;
    }
  }

  @media (max-width: 419px) {
    .wordmark__tag {
      display: none;
    }
  }
</style>
