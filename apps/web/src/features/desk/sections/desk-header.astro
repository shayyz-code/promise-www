---
import type { Business } from '@promise-www/content'
import LanguageSwitch from '../../../components/layout/language-switch.astro'
import LogoMark from '../../../components/ui/logo-mark.astro'
import type { Locale } from '../../../i18n/config'
import type { DeskDictionary } from '../../../i18n/dictionaries/types'
import type { DeskLinks } from '../desk-links'
import { latinLang } from '../lang'
import DeskStrip from './desk-strip.astro'

interface Props {
  locale: Locale
  t: DeskDictionary
  business: Business
  links: DeskLinks
}

const { locale, t, business, links } = Astro.props
const lang = latinLang(locale)
const navItems = [
  { href: '#shelf', label: t.navShelf },
  { href: '#how', label: t.navHow },
  { href: '#community', label: t.navCommunity },
  { href: '#visit', label: t.navVisit },
]
---

<header>
  <DeskStrip locale={locale} t={t} business={business} links={links} />
  <div class="pd-wrap head">
    <a class="brand" href="#top" aria-label={t.homeLabel}>
      <LogoMark />
      <span class="brand__word" lang={lang}>Promise</span>
      <span class="brand__chip" lang={lang}>desk</span>
    </a>
    <nav class="nav" aria-label={t.navMain}>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <LanguageSwitch section="desk" locale={locale} variant="desk" />
    <a class="pd-btn pd-btn-tg pd-btn-sm head__tg" href={links.bot.href} lang={lang}>Telegram</a>
    <a class="pd-btn pd-btn-dc pd-btn-sm head__dc" href={links.discord.href} lang={lang}>Discord</a>
  </div>
</header>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-right: auto;
  }

  .brand :global(.logo-mark) {
    width: 30px;
    height: 41px;
  }

  .brand__word {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .brand__chip {
    display: inline-block;
    padding: 2px 10px 0;
    border: 2px solid var(--color-navy);
    border-radius: 10px;
    background: var(--color-desk-yellow);
    color: var(--color-navy);
    box-shadow: 2px 2px 0 var(--color-navy);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    transform: rotate(-4deg);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 26px;
    font-size: 16px;
    font-weight: 600;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  :global(html[lang='my']) .nav {
    line-height: 1.5;
    letter-spacing: normal;
  }

  @media (max-width: 1279px) {
    .head__dc {
      display: none;
    }
  }

  @media (max-width: 1099px) {
    .head__tg {
      display: none;
    }

    .nav {
      gap: 0 18px;
      font-size: 15px;
    }

    .head {
      gap: 12px 20px;
    }
  }

  @media (max-width: 767px) {
    .nav {
      display: none;
    }

    .head {
      gap: 12px;
    }
  }

  @media (max-width: 400px) {
    .brand__word {
      font-size: 26px;
    }

    .brand :global(.logo-mark) {
      width: 24px;
      height: 33px;
    }

    .brand__chip {
      font-size: 15px;
      padding: 2px 8px 0;
    }
  }
</style>
