---
import type { Business } from '@promise-www/content'
import Icon from '../../../components/ui/icon.astro'
import { localize } from '../../../i18n'
import type { Locale } from '../../../i18n/config'
import type { DeskDictionary } from '../../../i18n/dictionaries/types'
import type { DeskLinks } from '../desk-links'
import { latinLang } from '../lang'

interface Props {
  locale: Locale
  t: DeskDictionary
  business: Business
  links: DeskLinks
}

const { locale, t, business, links } = Astro.props
const lang = latinLang(locale)
const { address } = business
const addressLines = [
  `${address.street},`,
  `${address.area}, ${address.city} ${address.postalCode}`,
  address.country,
]
const days = localize(business.hours.days, locale)
const time = localize(business.hours.time, locale)
---

<section id="visit" aria-labelledby="visit-title" class="visit">
  <div class="pd-wrap pd-sec visit__inner" data-reveal>
    <div class="visit__text">
      <span class="pd-pill pd-pill-navy pd-mono pd-caps reveal">{t.visitTag}</span>
      <h2 id="visit-title" class="pd-h2 pd-display reveal pd-d-06">{t.visitTitle}</h2>
      <p class="pd-body reveal pd-d-12">{t.visitBody}</p>
      <div class="visit__ctas reveal pd-d-18">
        <a class="pd-btn pd-btn-gold" href={links.map}>
          {t.visitMaps}
          <Icon name="arrow-right" size={18} strokeWidth={2.2} class="pd-arrow" />
        </a>
        <a class="pd-btn pd-btn-navy" href={links.primary.tel}>{t.callPre}{links.primary.number}{t.callPost}</a>
      </div>
    </div>

    <div class="receipt pd-mono pd-tilted reveal pd-d-12">
      <div class="receipt__head">
        <h3 class="receipt__name"><span lang={lang}>{business.name}</span></h3>
        <address class="receipt__address" lang={lang}>
          {addressLines.map((line, index) => (index === 0 ? line : [<br />, line]))}
        </address>
      </div>
      <span class="receipt__rule" aria-hidden="true"></span>
      <dl class="receipt__list">
        <dt>{t.rcOpen}</dt>
        <dd>
          <span class="receipt__hours">{days}<br />{time}</span>
        </dd>
        <dt>{t.rcCall}</dt>
        <dd>
          <a class="tap receipt__strong" href={links.primary.tel}><span class="pd-link">{links.primary.number}</span></a>
        </dd>
        <dt class="receipt__brand" lang={lang}>Viber</dt>
        <dd>
          <a class="tap" href={links.viber}><span class="pd-link">{links.primary.number}</span></a>
        </dd>
        <dt>{t.rcAlso}</dt>
        <dd>
          {
            links.others.map((phone) => (
              <a class="tap" href={phone.tel}>
                <span class="pd-link">{phone.number}</span>
              </a>
            ))
          }
        </dd>
        <dt class="receipt__brand" lang={lang}>Telegram</dt>
        <dd>
          <a class="tap" href={links.shop.href}><span class="pd-link" lang={lang}>{links.shop.handle}</span></a>
        </dd>
        <dt>{t.rcBot}</dt>
        <dd>
          <a class="tap" href={links.bot.href}><span class="pd-link" lang={lang}>{links.bot.handle}</span></a>
        </dd>
        <dt>{t.rcEmail}</dt>
        <dd>
          <a class="tap" href={links.email.href}><span class="pd-link">{links.email.address}</span></a>
        </dd>
      </dl>
      <span class="receipt__rule" aria-hidden="true"></span>
      <p class="receipt__thanks pd-caps">{t.rcThanks}</p>
    </div>
  </div>
</section>

<style>
  .visit {
    border-top: 2px solid var(--color-navy);
  }

  .visit__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
  }

  .visit__text {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .visit__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
  }

  /* The tilted till receipt */
  .receipt {
    --r: 1.5deg;
    flex: 0 1 440px;
    min-width: 0;
    box-sizing: border-box;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 26px;
    border: 2px solid var(--color-navy);
    border-radius: 6px;
    background: var(--color-card);
    box-shadow: 6px 6px 0 var(--color-navy);
    font-size: 14px;
    line-height: 1.55;
  }

  .receipt__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .receipt__name {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .receipt__address {
    font-style: normal;
  }

  .receipt__rule {
    display: block;
    border-top: 2px dashed var(--color-navy);
  }

  .receipt__list {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0 16px;
  }

  .receipt__list dt {
    font-weight: 700;
    text-transform: uppercase;
  }

  .receipt__list dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0 12px;
    min-height: 44px;
    text-align: right;
  }

  .receipt__hours {
    padding: 8px 0;
  }

  .receipt__strong {
    font-weight: 700;
  }

  .receipt__thanks {
    margin: 0;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  :global(html[lang='my']) .receipt__list dt {
    text-transform: none;
    letter-spacing: normal;
  }

  /* Brand labels stay in capitals in both languages, as in the design. */
  :global(html[lang='my']) .receipt__list .receipt__brand {
    text-transform: uppercase;
  }
</style>
