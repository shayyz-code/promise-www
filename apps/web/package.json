    "deploy": "node scripts/check-deploy-env.ts && astro build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@promise-www/content": "workspace:*",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
