{
  "name": "@promise-www/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 8787",
    "typecheck": "astro check",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:deployed": "playwright test --config playwright.deployed.config.ts",
    "lhci": "lhci autorun",
